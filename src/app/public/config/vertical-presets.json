{
  "pharmacy": {
    "displayName": "Pharmacy/Drugstore",
    "description": "Configuration for pharmacy and drugstore operations",
    "metrics": {
      "primaryKPI": {
        "displayName": "Store Performance",
        "description": "Overall store performance score based on inventory and operations",
        "targets": {
          "optimal": 93,
          "attention": 92,
          "priority": 90
        }
      },
      "secondaryKPI": {
        "displayName": "Days of Supply",
        "description": "Average days of inventory on hand",
        "target": 60,
        "criticalThreshold": 30
      },
      "additionalMetrics": [
        {
          "name": "fill_rate",
          "displayName": "Prescription Fill Rate",
          "unit": "percentage",
          "target": 95,
          "description": "Percentage of prescriptions filled same-day"
        },
        {
          "name": "customer_wait_time",
          "displayName": "Avg Customer Wait Time",
          "unit": "minutes",
          "target": 5,
          "description": "Average wait time at pharmacy counter"
        },
        {
          "name": "immunization_rate",
          "displayName": "Immunization Rate",
          "unit": "per_day",
          "target": 25,
          "description": "Average immunizations administered per day"
        }
      ]
    },
    "categories": [
      {
        "displayName": "Flu Vaccines & Immunizations",
        "priority": "critical",
        "seasonality": "high",
        "dosTarget": 60,
        "ssisTarget": 95,
        "description": "Flu vaccine inventory and immunization services"
      },
      {
        "displayName": "Cold & Flu Medicine",
        "priority": "high",
        "seasonality": "medium",
        "dosTarget": 45,
        "ssisTarget": 93,
        "description": "Over-the-counter cold and flu remedies"
      },
      {
        "displayName": "Cough Drops & Throat Relief",
        "priority": "high",
        "seasonality": "medium",
        "dosTarget": 30,
        "ssisTarget": 92,
        "description": "Cough drops and throat lozenges"
      },
      {
        "displayName": "Vitamins & Supplements",
        "priority": "medium",
        "seasonality": "low",
        "dosTarget": 45,
        "ssisTarget": 90,
        "description": "Vitamins and nutritional supplements"
      },
      {
        "displayName": "Pain Relief Medications",
        "priority": "high",
        "seasonality": "low",
        "dosTarget": 60,
        "ssisTarget": 95,
        "description": "Analgesics and pain management products"
      }
    ],
    "agent": {
      "role": "Retail Pharmacy Operations Advisor",
      "expertise": [
        "inventory optimization",
        "pharmacy operations",
        "seasonal demand planning",
        "patient safety",
        "regulatory compliance"
      ],
      "systemPromptFile": "pharmacy-prompt.txt",
      "terminology": {
        "store": "store",
        "location": "location",
        "manager": "store manager",
        "headquarters": "corporate office",
        "customer": "patient/customer",
        "inventory": "inventory",
        "product": "item"
      }
    },
    "demo": {
      "scenarioName": "Cold/Flu Season Crisis",
      "scenarioDescription": "Analyzing supply chain disruptions during peak cold and flu season"
    }
  },
  
